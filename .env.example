# GitHub OAuth App — required for "Login with GitHub"
# Create an OAuth App at: https://github.com/settings/developers
#   Homepage URL:            https://your-studio.vercel.app
#   Authorization callback URL: https://your-studio.vercel.app
# Then set the Client ID here and the Client Secret in Vercel dashboard.

VITE_GITHUB_CLIENT_ID=your_oauth_app_client_id_here

# Keep this ONLY in Vercel environment variables — never commit it!
GITHUB_CLIENT_SECRET=your_oauth_app_client_secret_here
